summary: All Dogtag GHA↔TMT parity tests
description: |
  Aggregate plan that discovers every TMT test ported from a GHA
  *-test.yml workflow.  Each test lives under tests/tmt/<stem>/.
discover:
    how: fmf
    filter: "tag: idm-8254 & tag: dogtag"
provision:
    how: local
prepare:
    - name: require-docker
      how: shell
      script:
        - |
          command -v docker >/dev/null \
            || { echo "ERROR: docker required"; exit 1; }
    - name: build-pki-runner
      how: shell
      script:
        - |
          "${TMT_TREE}/tests/tmt/bin/build-pki-runner.sh" "${TMT_TREE}"
execute:
    how: tmt
finish:
    how: shell
    script:
      - |
        docker rm -f pki ds 2>/dev/null || true
        docker volume rm ds-data 2>/dev/null || true
        docker network rm example 2>/dev/null || true
tag:
    - dogtag
    - idm-8254
    - aggregate
link:
    - verifies: https://redhat.atlassian.net/browse/IDM-8254
